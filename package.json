{
  "name": "agentview",
  "version": "0.1.0",
  "description": "Local Agent View-style controller for Codex sessions",
  "type": "module",
  "bin": {
    "agentview": "./dist/bin/agentview.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin/agentview.js",
    "start": "node ./dist/bin/agentview.js",
    "test": "npm run build && node --test",
    "test:e2e:real": "npm run build && node ./dist/scripts/e2e-real-codex.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3"
  }
}
