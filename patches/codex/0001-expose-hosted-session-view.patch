diff --git a/codex-rs/tui/src/hosted.rs b/codex-rs/tui/src/hosted.rs
new file mode 100644
index 0000000000..e5135b9ed4
--- /dev/null
+++ b/codex-rs/tui/src/hosted.rs
@@ -0,0 +1,54 @@
+use std::path::PathBuf;
+
+use clap::Parser;
+use codex_arg0::Arg0DispatchPaths;
+use codex_config::LoaderOverrides;
+
+use crate::Cli;
+use crate::ExitReason;
+use crate::run_main;
+
+#[derive(Debug, Clone)]
+pub struct HostedSessionConfig {
+    pub thread_id: String,
+    pub cwd: Option<PathBuf>,
+    pub remote_url: Option<String>,
+    pub remote_auth_token: Option<String>,
+    pub no_alt_screen: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum HostedSessionExit {
+    Detached,
+    Quit,
+    Fatal(String),
+}
+
+pub async fn run_hosted_session_view(
+    config: HostedSessionConfig,
+    arg0_paths: Arg0DispatchPaths,
+    loader_overrides: LoaderOverrides,
+) -> std::io::Result<HostedSessionExit> {
+    let mut cli = Cli::try_parse_from(["codex-tui"]).map_err(std::io::Error::other)?;
+    cli.resume_session_id = Some(config.thread_id);
+    cli.resume_show_all = true;
+    cli.resume_include_non_interactive = true;
+    cli.hosted_detach_enabled = true;
+    cli.cwd = config.cwd;
+    cli.no_alt_screen = config.no_alt_screen;
+
+    let exit_info = run_main(
+        cli,
+        arg0_paths,
+        loader_overrides,
+        config.remote_url,
+        config.remote_auth_token,
+    )
+    .await?;
+
+    Ok(match exit_info.exit_reason {
+        ExitReason::Detached => HostedSessionExit::Detached,
+        ExitReason::UserRequested => HostedSessionExit::Quit,
+        ExitReason::Fatal(message) => HostedSessionExit::Fatal(message),
+    })
+}
